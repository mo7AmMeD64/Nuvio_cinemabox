<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike de UEP para Tizen 4.0/5.0 (TVs 2018-2020). ElmSharp puro (sem GL,
       sem Xamarin.Forms): so precisa mostrar texto. Testa se memfd_create +
       dlopen("/proc/self/fd/N") contorna a UEP onde o dlopen de arquivo falha.
       Pacote/appid PROPRIO (NvUepProbe): nao encosta nos pacotes publicados. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen40</TargetFramework>
    <RootNamespace>NvUepProbe</RootNamespace>
    <AssemblyName>NvUepProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="Tizen.NET" Version="4.0.*">
      <ExcludeAssets>Runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Tizen.NET.Sdk" Version="1.1.*" />
  </ItemGroup>

  <ItemGroup>
    <TizenNativeLibrary Include="lib\libnvprobe.so" Condition="Exists('lib\libnvprobe.so')" />
  </ItemGroup>

</Project>
