<Project Sdk="Microsoft.NET.Sdk">

  <!-- Spike 2 de UEP para Tizen 4.0/5.0 (TVs 2018-2020). Continuacao do
       NvUepProbe: aquele provou que file-backed PROT_EXEC (dlopen de arquivo)
       e bloqueado pela UEP, mas que memoria anonima executavel e PERMITIDA
       (mprotect +EXEC deu OK). O erro do NvUepProbe foi chamar memfd_create
       por NOME (DllImport): a libc do Tizen 4/5 nao exporta esse simbolo e o
       CLR lanca EntryPointNotFoundException. Aqui memfd_create e chamado pelo
       NUMERO do syscall (385, ARM EABI), e ha um carregador de ELF proprio em
       C# como rota D (a que so depende de memoria anonima).
       Pacote/appid PROPRIO (NvMemfd): nao encosta nos pacotes publicados. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>tizen40</TargetFramework>
    <RootNamespace>NvMemfd</RootNamespace>
    <AssemblyName>NvMemfd</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <PackageReference Include="Tizen.NET" Version="4.0.*">
      <ExcludeAssets>Runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Tizen.NET.Sdk" Version="1.1.*" />
  </ItemGroup>

  <ItemGroup>
    <TizenNativeLibrary Include="lib\libnvprobe.so" Condition="Exists('lib\libnvprobe.so')" />
  </ItemGroup>

</Project>
